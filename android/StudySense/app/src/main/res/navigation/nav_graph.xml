<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.studysense.app.ui.splash.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_profileSetup"
            app:destination="@id/profileSetupFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_dashboard"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/profileSetupFragment"
        android:name="com.studysense.app.ui.profile.ProfileSetupFragment"
        android:label="Profile Setup"
        tools:layout="@layout/fragment_profile_setup">
        <action
            android:id="@+id/action_profileSetup_to_dashboard"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/profileSetupFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.studysense.app.ui.dashboard.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard">
        <action
            android:id="@+id/action_dashboard_to_subjects"
            app:destination="@id/subjectsFragment" />
    </fragment>

    <fragment
        android:id="@+id/subjectsFragment"
        android:name="com.studysense.app.ui.subjects.SubjectsFragment"
        android:label="Subjects"
        tools:layout="@layout/fragment_subjects">
        <action
            android:id="@+id/action_subjects_to_addEditSubject"
            app:destination="@id/addEditSubjectFragment" />
    </fragment>

    <fragment
        android:id="@+id/addEditSubjectFragment"
        android:name="com.studysense.app.ui.subjects.AddEditSubjectFragment"
        android:label="Add / Edit Subject"
        tools:layout="@layout/fragment_add_edit_subject">
        <argument
            android:name="subjectId"
            app:argType="long"
            android:defaultValue="0L" />
    </fragment>

</navigation>
